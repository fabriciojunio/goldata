# Ambiente: development | staging | production
# Em production, SECRET_KEY e API_KEY padrão são rejeitados na inicialização.
ENVIRONMENT=development

# Banco de Dados
DB_USER=goldata
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DATABASE_URL=postgresql+asyncpg://${DB_USER:-goldata}:${DB_PASSWORD}@localhost:5432/goldata
DATABASE_URL_SYNC=postgresql+psycopg2://${DB_USER:-goldata}:${DB_PASSWORD}@localhost:5432/goldata

# API (gere com: openssl rand -hex 32). SECRET_KEY precisa de no mínimo 32 caracteres.
SECRET_KEY=TROQUE_POR_CHAVE_ALEATORIA_COM_32_CHARS_OU_MAIS
API_KEY=TROQUE_POR_API_KEY_ALEATORIA

# CORS: lista JSON de origens permitidas
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# LGPD: retenção de dados pessoais em dias
DATA_RETENTION_DAYS=365
